{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "server/main.ts",
    "server/rpc.ts",
    "server/*.test.ts",
    "shared/*.test.ts",
    "scripts/*.{ts,mjs}",
    "website/src/*.test.ts",
    "website/app/{layout,robots,sitemap,manifest}.tsx",
    "website/app/{robots,sitemap,manifest}.ts",
    "website/app/**/page.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/*.{ts,mjs}",
    "website/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "*.{ts,mjs}"
  ],
  "ignoreDependencies": ["@tauri-apps/cli"],
  "ignoreBinaries": ["rustc", "cmake", "ffprobe", "ffmpeg"]
}
