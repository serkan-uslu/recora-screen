# Copy to website/.env.local. Never put private API keys in NEXT_PUBLIC_ values.
# Leave empty to disable analytics. Paste the pa-*.js URL from your Plausible site snippet.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Optional published release asset URL; otherwise build:site copies the local DMG.
NEXT_PUBLIC_DOWNLOAD_URL=

# Public canonical URL. GitHub Pages project path must be included.
NEXT_PUBLIC_SITE_URL=https://serkan-uslu.github.io/recora-screen/
# Keep empty locally. GitHub Pages sets this to /recora-screen.
NEXT_PUBLIC_BASE_PATH=
